NEXT_PUBLIC_SITE_URL=https://artisticentrances.co
N8N_QUOTE_WEBHOOK_URL=
N8N_QUOTE_WEBHOOK_TOKEN=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=uK4q8lpwDpm1J32DZxO4
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artistic-entrances-doors

# Planner: paints the old door out of the entry photo (replicate.com)
REPLICATE_API_TOKEN=

# Optional: Google Maps Embed API key. Leave empty to use the keyless map embed on the showroom map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional GoHighLevel custom field ids for lead interest and attribution.
# Create each field in GHL (Settings > Custom Fields), copy its id here. Empty = skipped.
# Doors the visitor looked at, for example "Door 8, Door 21".
GHL_FIELD_INTEREST_DOORS=
# The single most interesting door, for example "Door 8 (website-images-8)".
GHL_FIELD_TOP_DOOR=
# Favorite glass name.
GHL_FIELD_INTEREST_GLASS=
# Favorite finish name.
GHL_FIELD_INTEREST_FINISH=
# How the visitor first found the site (source / medium / campaign, landing page, date).
GHL_FIELD_FIRST_TOUCH=
# The visit that led to the form (same format as first touch).
GHL_FIELD_LAST_TOUCH=
# Google Ads click id, for offline conversion import.
GHL_FIELD_GCLID=
# GA4 client id, for joining the lead to GA4 or BigQuery sessions.
GHL_FIELD_GA_CLIENT_ID=

# ---- Conversion tracking (see docs/launch-runbook.md) ----
# Meta Pixel id (Events Manager > Data sources). Turns on the browser pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API access token (Events Manager > Settings > Generate access token). Server only.
META_CAPI_ACCESS_TOKEN=
# Optional: a Test Events code while checking CAPI in Events Manager. Remove after testing.
META_TEST_EVENT_CODE=
# Optional: Graph API version for CAPI calls.
META_GRAPH_VERSION=v22.0
# GA4 Measurement Protocol API secret (GA4 Admin > Data streams > web > Measurement Protocol API secrets). Server only.
GA4_API_SECRET=
# Google Ads lead conversion "send to" value, e.g. AW-17928892397/AbCdEfGh (Ads > Goals > Conversions > Tag setup).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
# 1 = send the lead's email and phone to Google's tag for enhanced conversions (hashed by Google). Mention in the privacy policy.
NEXT_PUBLIC_ENHANCED_CONVERSIONS=
# GoHighLevel number pool script URL (Settings > Phone Numbers > Number Pools). Swaps the showroom number per visitor.
NEXT_PUBLIC_GHL_CALL_TRACKING_SRC=
# Optional: GHL visitor-session script. Defaults to https://backend.leadconnectorhq.com/appengine/js/user_session.js
NEXT_PUBLIC_GHL_SESSION_SRC=
